{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterDefendant.json",
  "description": "The details of a defendant rendered in a court register document",
  "type": "object",
  "properties": {
    "masterDefendantId": {
      "$ref": "http://justice.gov.uk/core/courts/courtsDefinitions.json#/definitions/uuid"
    },
    "name": {
      "description": "The defendant last name",
      "type": "string"
    },
    "dateOfBirth": {
      "description": "The defendant date of birth",
      "type": "string",
      "format": "date"
    },
    "address": {
      "description": "The defendant address",
      "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterAddress.json"
    },
    "nationality": {
      "type": "string"
    },
    "ethnicity": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "postHearingCustodyStatus": {
      "type": "string"
    },
    "parentGuardian": {
      "description": "The defendant parent guardian details",
      "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterParentGuardian.json"
    },
    "hearing": {
      "description": "The defendant hearing details",
      "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterHearing.json"
    },
    "aliases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterDefendantAlias.json"
      }
    },
    "prosecutionCasesOrApplications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterCaseOrApplication.json"
      }
    },
    "defendantResults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterResult.json"
      }
    },
    "defenceCounsels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterCounsel.json"
      }
    }
  },
  "required": [
    "name",
    "address",
    "prosecutionCasesOrApplications"
  ],
  "additionalProperties": false
}