{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "id": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterCaseOrApplication.json",
  "description": "The details of a defendants prosecution case or application rendered in a court register document",
  "type": "object",
  "properties": {
    "caseOrApplicationReference": {
      "description": "The case or application reference",
      "type": "string"
    },
    "courtApplicationId": {
      "description": "The court application id",
      "$ref": "http://justice.gov.uk/domain/core/common/definitions.json#/definitions/uuid"
    },
    "prosecutorName": {
      "description": "The name of the prosecuting authority",
      "type": "string"
    },
    "applicationType": {
      "description": "The description from reference data for the type of application",
      "type": "string"
    },
    "applicationDecision": {
      "description": "The court outcome for the application",
      "type": "string"
    },
    "applicationDecisionDate": {
      "description": "The application decision date",
      "type": "string",
      "format": "date"
    },
    "applicationResponse": {
      "description": "The application respondents response",
      "type": "string"
    },
    "applicationResponseDate": {
      "description": "The application response date",
      "type": "string",
      "format": "date"
    },
    "offences": {
      "description": "The offences of the prosecution case",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterOffence.json"
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterResult.json"
      }
    },
    "prosecutionCounsels": {
      "description": "The prosecution counsel details",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "http://justice.gov.uk/core/courts/courtRegisterDocument/courtRegisterCounsel.json"
      }
    },
    "arrestSummonsNumber": {
      "description": "The police arrest summons number when the defendant is a person",
      "type": "string"
    }
  },
  "required": [
    "caseOrApplicationReference"
  ],
  "additionalProperties": false
}