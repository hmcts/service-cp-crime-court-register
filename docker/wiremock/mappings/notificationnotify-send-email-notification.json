{
  "name": "notificationnotify command: send-email-notification (202)",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPathPattern": "/notificationnotify-command-api/command/api/rest/notificationnotify/notifications/[0-9a-fA-F-]{36}",
    "headers": {
      "Content-Type": {
        "matches": "application/vnd\\.notificationnotify\\.email\\+json.*"
      }
    },
    "bodyPatterns": [
      { "matchesJsonPath": "$.templateId" },
      { "matchesJsonPath": "$.sendToAddress" }
    ]
  },
  "response": {
    "status": 202
  }
}
